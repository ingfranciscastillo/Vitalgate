# Copy to .env.local for development. In production, set these in Vercel's
# project environment variables.

# --- Required ---------------------------------------------------------------

# Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public origin of the app, no trailing slash. Must be https in production.
# Used by better-auth and for every absolute link Vitalgate generates
# (OAuth callbacks, invitation/digest emails, the ingest URL in workflows).
BETTER_AUTH_URL=http://localhost:3000

# Signs sessions and OAuth state, and encrypts stored GitHub tokens.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Callback URL: $BETTER_AUTH_URL/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App ---------------------------------------------------------------

# From the app's settings page (github.com/settings/apps/<slug>).
# Setup URL: $BETTER_AUTH_URL/api/github/setup (with "Redirect on update").
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The downloaded .pem private key, base64-encoded on one line:
#   base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
# Webhook URL: $BETTER_AUTH_URL/api/github/webhook, with this secret.
# Subscribe the app to the "Repository" event. Generate: openssl rand -hex 32
GITHUB_APP_WEBHOOK_SECRET=

# --- Email (invitations, weekly digest, contact form) -------------------------

RESEND_API_KEY=
# A sender on a domain verified in Resend. Without one, Resend's sandbox
# sender only delivers to the Resend account's own address.
RESEND_FROM_EMAIL="Vitalgate <noreply@example.com>"
# Where contact form messages are delivered.
CONTACT_EMAIL=

# --- Weekly digest cron -----------------------------------------------------

# Vercel Cron sends it as a Bearer token. Generate: openssl rand -base64 32
CRON_SECRET=

# --- Slack / Discord alerts (Pro) ---------------------------------------------

# Encrypts stored webhook URLs. Must decode to 32 bytes.
# Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Redirect URI: $BETTER_AUTH_URL/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Redirect URI: $BETTER_AUTH_URL/api/integrations/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Real-user metrics (Chrome UX Report) ------------------------------------

# Google Cloud API key with the Chrome UX Report API enabled. Free.
# Without it, repository pages explain how to turn real-user metrics on.
CRUX_API_KEY=

# --- Pro billing (Polar) ------------------------------------------------------

# Organization access token (Settings -> Developers) with checkout, customer,
# subscription and customer-session scopes. Sandbox and production are separate.
POLAR_ACCESS_TOKEN=
# Webhook endpoint: $BETTER_AUTH_URL/api/auth/polar/webhooks, subscribed to the
# subscription.* events. Paste its signing secret here.
POLAR_WEBHOOK_SECRET=
# ID of the monthly "Pro" product.
POLAR_PRO_PRODUCT_ID=
# "sandbox" (default) or "production".
POLAR_ENVIRONMENT=sandbox
